# @nuxt/cli depends on crc, which names buffer >=6.0.3 as an OPTIONAL peer and
# never loads it here. webpack 4's node-libs-browser needs buffer ^4.3.0, and
# npm hoists that copy to the root of this tree, where it lands in crc's
# resolution scope. npm 8, which .nvmrc pins, then reads the hoisted 4.9.2 as
# crc's peer and refuses the tree: `npm ci` fails with "lock file's buffer@4.9.2
# does not satisfy buffer@6.0.3" on a lock file npm install just wrote.
#
# The two ranges are disjoint, so no single version satisfies both, and the one
# crc asks for would be installed for nothing. Peer resolution is left to the
# legacy algorithm instead.
legacy-peer-deps=true
